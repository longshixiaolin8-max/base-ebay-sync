{
  "name": "ai-ec-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "cdk:synth": "pnpm --filter infra run synth",
    "security:report": "node scripts/security-report.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.18",
      "drizzle-orm": "0.45.2",
      "source-map-js": "1.2.2"
    }
  }
}
