{
  "name": "ai-ec-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "cdk:synth": "pnpm --filter infra run synth"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.18",
      "drizzle-orm": "0.45.2"
    }
  }
}
