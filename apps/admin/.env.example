# Public, non-secret identifiers only. Set these as Amplify Hosting build-time
# environment variables (Amplify Console > App settings > Environment variables),
# not in Secrets Manager (nothing here is a credential).
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com
